# Opcional: si és buit, el servidor genera una contrasenya i la mostra a la consola.
# Mínim 12 caràcters. Mai distribuir aquest fitxer amb la contrasenya.
CONTROWL_ADMIN_PASSWORD=
PORT=3000
# Aula: certificat de confiança als ordinadors dels alumnes.
# CONTROWL_TLS_CERT=certs/server.pem
# CONTROWL_TLS_KEY=certs/server-key.pem
# Sense TLS només s’escolta a localhost (proves al PC del docent).
